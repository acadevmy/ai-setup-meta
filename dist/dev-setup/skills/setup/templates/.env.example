# ============================================================
# Environment variables — copy to .env and fill in the values
# Do NOT commit the .env file to the repository
# ============================================================

# ── Task tracker ──────────────────────────────────────────────
# .claude/tracker.json says which tracker and which list; these two
# override it for one machine. The API key is for headless runs only.
TRACKER_PROVIDER=
TRACKER_LIST_ID=

# ── Template version ──────────────────────────────────────────────
TEMPLATE_VERSION=3.4.2 # x-release-please-version

# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
