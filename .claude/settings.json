{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(bash scripts/*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(head *)",
      "mcp__clickup__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin next*)",
      "Bash(git push origin dev*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * HEAD:master*)",
      "Bash(git push * HEAD:next*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit *--no-verify*)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "Bash(claude *--permission-mode bypassPermissions*)",
      "Bash(npm publish*)",
      "Bash(rm -rf /*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [".env", ".env.local", "**/.env", "**/.env.local"],
      "denyWrite": [".env", ".env.local", "**/.env", "**/.env.local"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "api.clickup.com"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" }
      ]
    }
  },
  "attribution": {
    "commits": true,
    "pullRequests": true
  }
}
